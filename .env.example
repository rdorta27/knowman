# Copy this file to .env (`cp .env.example .env`) and edit what you need.
# Docker Compose reads .env automatically and substitutes these values into
# docker-compose.yml; the same file is read by `uv run knowman ...` on the host.

# Ports published on 127.0.0.1, shared by both install modes. Change one when
# something else on the machine already holds it.
DB_PORT=5432
OLLAMA_PORT=11434
API_PORT=8000

# Host values: inside the containers, Compose overrides both with service names
# (db, ollama), so these only apply when running knowman directly on the host.
# Keep their ports in step with DB_PORT and OLLAMA_PORT above.
DATABASE_URL=postgresql://knowman:knowman@localhost:5432/knowman
OLLAMA_URL=http://localhost:11434

EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_MODEL=qwen3-embedding:0.6b
CORPUS_PATH=corpus/dummy

RETRIEVAL_MAX_DISTANCE=0.5
RETRIEVAL_DEFAULT_K=3
PROMPT_VERSION=ask_v1

# Unset (the default) leaves every route open, exactly as with no access
# control at all. Set both before exposing the API beyond localhost.
# API_TOKEN=
RATE_LIMIT_PER_MINUTE=0

# LLM_PROVIDER=ollama
CHAT_MODEL=qwen3.5:0.8b
AGENT_MODEL=qwen3.5:2b
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# XAI_API_KEY=
XAI_MODEL=grok-4

# Owner of the files the containers write; must match your host user (`id -u`).
KNOWMAN_UID=1000
KNOWMAN_GID=1000

# GPU: install.sh sets this when the host exposes /dev/dri. Comment it to force CPU.
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml
